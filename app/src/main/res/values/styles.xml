<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shape Models -->
    <style name="ShapeAppearance.Cinematic.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_small</item>
    </style>

    <style name="ShapeAppearance.Cinematic.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_medium</item>
    </style>

    <style name="ShapeAppearance.Cinematic.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_large</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.Cinematic.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/md_theme_dark_primary</item>
        <item name="android:textColor">@color/md_theme_dark_onPrimary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Cinematic.Large</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Cinematic.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/md_theme_dark_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/md_theme_dark_onSurface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Cinematic.Large</item>
        <item name="android:minHeight">@dimen/button_height</item>
    </style>

    <!-- Cards (Movie Posters) -->
    <style name="Widget.Cinematic.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/md_theme_dark_surface</item>
        <item name="cardElevation">4dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Cinematic.Medium</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="Widget.Cinematic.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/md_theme_dark_background</item>
        <item name="itemIconTint">@color/md_theme_dark_onSurfaceVariant</item>
        <item name="itemTextColor">@color/md_theme_dark_onSurfaceVariant</item>
        <item name="itemActiveIndicatorStyle">@null</item> <!-- Clean, text/icon highlights only -->
    </style>

    <!-- Search Input Text Field -->
    <style name="Widget.Cinematic.SearchInput" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/md_theme_dark_surfaceVariant</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_radius_large</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_radius_large</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_radius_large</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_radius_large</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintTextColor">@color/md_theme_dark_onSurfaceVariant</item>
        <item name="android:textColorHint">@color/md_theme_dark_onSurfaceVariant</item>
    </style>

    <!-- Typography -->
    <style name="TextAppearance.Cinematic.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/md_theme_dark_onBackground</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Cinematic.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/md_theme_dark_onBackground</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Cinematic.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/md_theme_dark_onSurfaceVariant</item>
    </style>
        <!-- TabLayout -->
    <style name="Widget.Cinematic.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabBackground">@color/md_theme_dark_surface</item>
        <item name="tabIndicatorColor">@color/md_theme_dark_primary</item>
        <item name="tabSelectedTextColor">@color/md_theme_dark_primary</item>
        <item name="tabTextColor">@color/md_theme_dark_onSurfaceVariant</item>
        <item name="tabIndicatorHeight">3dp</item>
    </style>
    
    <style name="CustomTabLayout" parent="Widget.Material3.TabLayout.Secondary">
    <item name="tabTextAppearance">@style/CustomTabTextAppearance</item>
</style>

<style name="CustomTabTextAppearance" parent="TextAppearance.AppCompat.Button">
    <item name="android:textSize">14sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:fontFamily">sans-serif-medium</item>
</style>

<style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
    <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
</style>

<style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
    <item name="android:background">@android:color/transparent</item>
    <item name="android:windowAnimationStyle">@style/CustomAnimation</item>
</style>

<style name="CustomAnimation">
    <item name="android:windowEnterAnimation">@anim/slide_up_bounce</item>
    <item name="android:windowExitAnimation">@anim/slide_down</item>
</style>
<style name="DarkDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="backgroundColor">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B3FFFFFF</item>
        <item name="buttonBarPositiveButtonStyle">@style/DarkPositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DarkNegativeButton</item>
        <item name="alertDialogTheme">@style/DarkAlertDialogStyle</item>
    </style>
    <style name="DarkPositiveButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/dark_button_positive</item>
    </style>
    <style name="DarkNegativeButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/dark_button_negative</item>
    </style>
    <style name="DarkAlertDialogStyle" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B3FFFFFF</item>
    </style>
    
    <style name="Theme.Transparent" parent="Theme.Material3.DayNight.NoActionBar">
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowIsFloating">true</item>
    <item name="android:backgroundDimEnabled">false</item>
</style>

</resources>
